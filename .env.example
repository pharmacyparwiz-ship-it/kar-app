# Copy this file to .env before running the app locally, and set the same
# variables in your hosting provider's dashboard (Vercel/Railway/etc.) for
# production.

# DATABASE_URL — PostgreSQL connection string.
# Get a free Postgres database from Neon (neon.tech) or Supabase (supabase.com):
#   1. Create a free account and a new project
#   2. Copy the "connection string" they give you (starts with postgresql://)
#   3. Paste it here
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT_SECRET — used to sign login sessions. MUST be a long random string.
# Generate one with: openssl rand -base64 32
# (On Windows without openssl, use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# The app will refuse to start if this is missing, too short, or left as a placeholder.
JWT_SECRET="change-this-to-a-long-random-string"

# NODE_ENV — set automatically by most hosts. Only needed locally if you
# want to test production cookie behavior (Secure flag).
NODE_ENV="development"

# ADMIN_PHONES — comma-separated list of phone numbers that get access to
# the admin panel (/admin) after logging in. Use the exact phone number
# format the account registered with (e.g. 0700000000).
# Example with two admins: ADMIN_PHONES="0700000000,0700000001"
# Leave empty (or unset) to disable the admin panel entirely.
ADMIN_PHONES="0700000000"
